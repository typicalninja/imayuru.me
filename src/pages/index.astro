---
import "../styles/home.css";

import { Links } from "../lib/constants";
import HomeFooter from "../components/HomeFooter.astro";
import CenteredLayout from "../layout/CenteredLayout.astro";

const name = "Vidath Imayuru Weerawala";
const role = "Software Engineer";
const bio =
  "Building thoughtful digital experiences with a focus on minimal and functional design.";
---

<CenteredLayout>
  <header class="intro">
    <img src="/profile_pic.png" alt={name} class="profile-pic" />
    <div class="intro-text">
      <h1 class="name">{name}</h1>
      <p class="subtitle">{role}</p>
    </div>
  </header>

  <section>
    <p class="bio">{bio}</p>
  </section>

  <div class="socials">
    <a href="/downloads/cv.pdf" class="social-link cv-link"> Download CV </a>
    <a href={Links.github} target="_blank" class="social-link"> Github </a>
    <a href={Links.linkedin} target="_blank" class="social-link"> LinkedIn </a>
  </div>

  <hr />
  <HomeFooter />
</CenteredLayout>