---
import { Links } from "../lib/constants";
import { Sun, Moon } from "@lucide/astro";
import "../styles/global.css";

import "@fontsource-variable/inter";
import Head from "../components/Head.astro";
import HomeFooter from "../components/HomeFooter.astro";

const name = "Vidath Imayuru Weerawala";
const role = "Software Engineer";
const bio = "Building thoughtful digital experiences with a focus on minimal and functional design.";
---

<html lang="en">
  <head>
    <Head />
    <title>{name} | Personal Website</title>
  </head>
  <body>
    <button id="themeToggle" class="small ghost theme-toggle" aria-label="Toggle theme mode">
      <Sun class="theme-light-toggle-icon" size={20} />
      <Moon class="theme-dark-toggle-icon" size={20} />
    </button>

    <main>
      <header class="intro">
        <img src="/profile_pic.png" alt={name} class="profile-pic" />
        <div class="intro-text">
          <h1 class="name">{name}</h1>
          <p class="subtitle">{role}</p>
        </div>
      </header>

      <section>
        <p class="bio">{bio}</p>
      </section>

      <div class="socials">
        <a href="/downloads/cv.pdf" class="social-link cv-link">
          Download CV
        </a>
        <a href={Links.github} target="_blank" class="social-link">
          Github
        </a>
        <a href={Links.linkedin} target="_blank" class="social-link">
          LinkedIn
        </a>
      </div>

      <hr />
      <HomeFooter />
    </main>
    <script src="../lib/client-theme.ts" />
    <script>
      import '@knadh/oat/oat.min.css';
      import '@knadh/oat/oat.min.js';
    </script>
  </body>
</html>