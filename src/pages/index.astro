---
import "../styles/home.css";

import { Links } from "../lib/constants";
import CenteredLayout from "../layout/CenteredLayout.astro";
import { ArrowUpRight, Download, Github, Linkedin } from "@lucide/astro";

const name = "Vidath Imayuru";
const role = "Software Engineer & Open Source Enthusiast";
const bio =
  "I design and build thoughtful digital experiences, bridging user-centric design with clean, functional code.";

const education = [
  {
    degree: "BSc (Hons) in Computer Science",
    school: "University of Westminster",
    period: "2024 - present",
  },
  {
    degree: "Higher Education",
    school: "IIT - Informatics Institute of Technology",
    period: "2023 - 2024",
  },
];

const projects = [
  {
    name: "Budgitin",
    description: "Your money, intelligently managed.",
    tags: ["NextJS", "TypeScript", "Backend Engineering"],
    link: Links.budgitin,
  },
  {
    name: "google-sr",
    description:
      "JavaScript / TypeScript tools to fetch Google search results.",
    tags: ["TypeScript", "Web Scraping"],
    link: `${Links.github}/google-sr`,
  },
  {
    name: "ai-commit-helper",
    description:
      "CLI tool to generate git commit messages from git staged files",
    tags: ["NodeJS", "TypeScript", "CLI"],
    link: `${Links.github}/ai-commit-helper`,
  },
  {
    name: "disci",
    description:
      "NextJS like framework for discord bots (WIP)",
    tags: ["NodeJS", "TypeScript", "Bun"],
    link: `${Links.github}/disci`,
  },
];
---

<CenteredLayout>
  <section class="hero">
    <p class="hero-greeting">👋🏻 Hello, I'm</p>
    <h1 class="hero-name">{name}</h1>
    <p class="hero-role">{role}</p>
    <p class="hero-bio">{bio}</p>

    <div class="cta-row">
      <a href="/download-cv" class="button primary">
        <Download size={16} />
        Download CV
      </a>
      <a
        href={Links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="cta-icon-link"
        aria-label="GitHub"
      >
        <Github size={18} />
      </a>
      <a
        href={Links.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="cta-icon-link"
        aria-label="LinkedIn"
      >
        <Linkedin size={18} />
      </a>
    </div>
  </section>

  <hr class="section-divider" />

  <section class="section">
    <p class="section-label">Education</p>
    <div class="timeline">
      {
        education.map((edu, i) => (
          <div class="timeline-item">
            <div class="timeline-track">
              <span class="timeline-dot" />
              {i < education.length - 1 && <span class="timeline-line" />}
            </div>
            <div class="timeline-content">
              <span class="edu-period">{edu.period}</span>
              <p class="edu-degree">{edu.degree}</p>
              <p class="edu-school">{edu.school}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <hr class="section-divider" />

  <section class="section">
    <p class="section-label">Featured Projects</p>
    <div class="projects-grid">
      {
        projects.map((project) => (
          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="project-card"
          >
            <div class="project-card-header">
              <p class="project-name">{project.name}</p>
              <ArrowUpRight size={16} class="project-arrow" />
            </div>
            <p class="project-desc">{project.description}</p>
            <div class="project-tags">
              {project.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </section>
</CenteredLayout>