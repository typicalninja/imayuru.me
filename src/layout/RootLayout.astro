---
import "@fontsource-variable/inter";
// Style imports needed by oat
import "@knadh/oat/oat.min.css";
// our global styles
import "../styles/global.css";

// Head component for meta tags and favicons
import Head, { type Props } from "../components/Head.astro";

const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <Head title={title} description={description} />
  </head>
  <body>
    <slot />
    <script>
      // Oat client-side functionality
      // need to imported here so its available only in the client
      import "@knadh/oat/oat.min.js";
    </script>
    <script src="../lib/client-theme.ts"></script>
  </body>
</html>